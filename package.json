{
  "name": "drunkify",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "dev": "concurrently -k -n web,server -c cyan,magenta 'pnpm --filter @drunkify/web dev' 'pnpm --filter @drunkify/server dev'",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:check": "pnpm --filter @drunkify/content content:check",
    "db:generate:sqlite": "DB_DRIVER=sqlite drizzle-kit generate --config drizzle.config.ts",
    "db:generate:postgres": "DB_DRIVER=postgres drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "pnpm --filter @drunkify/server cli -- db migrate",
    "postgres:smoke": "pnpm --filter @drunkify/server exec tsx src/__tests__/postgres-smoke.ts",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "type": "module"
}
