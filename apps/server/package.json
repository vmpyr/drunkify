{
  "name": "@drunkify/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "drunkify": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@drunkify/content": "workspace:*",
    "@drunkify/shared": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^8.3.0",
    "@node-rs/argon2": "^2.2.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.5.0",
    "pg": "^8.23.0",
    "uuid": "^14.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  }
}
