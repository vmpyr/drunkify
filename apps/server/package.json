{
  "name": "@drunkify/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "drunkify": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@drunkify/content": "workspace:*",
    "@drunkify/shared": "workspace:*",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.5.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  }
}
