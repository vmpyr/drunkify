NODE_ENV=development
PORT=3000
PUBLIC_URL=                 # required in production, e.g. https://drunkify.example.com
DATA_DIR=/data
DB_DRIVER=sqlite
SQLITE_PATH=
DATABASE_URL=
ADMIN_EMAIL=                # required in production
ADMIN_PASSWORD=             # optional; random OTP logged if unset
SESSION_COOKIE_NAME=drunkify_session
COOKIE_SECURE=true
TRUST_PROXY=false
MAILER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Drunkify <no-reply@localhost>
GEO_VENUE_PROVIDER=none
OVERPASS_URL=https://overpass-api.de/api/interpreter
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_CSP_ORIGINS=https://tiles.openfreemap.org
LOG_LEVEL=info
TZ=
